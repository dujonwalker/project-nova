diff --git a/test/http-transport.test.js b/test/http-transport.test.js
new file mode 100644
index 0000000..b05b142
--- /dev/null
+++ b/test/http-transport.test.js
@@ -0,0 +1,157 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import http from 'node:http';
+
+import { validateAndReadImage } from '../src/image-utils.js';
+import { ErrorCode, VisionBridgeError } from '../src/errors.js';
+import { createHttpServer, getTransport } from '../src/http-transport.js';
+
+const FAKE_PNG = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+
+function parseMcpBody(text) {
+  const trimmed = text.trim();
+  if (trimmed.startsWith('{')) return JSON.parse(trimmed);
+  for (const line of trimmed.split('\n')) {
+    if (line.startsWith('data: ')) {
+      return JSON.parse(line.slice(6));
+    }
+  }
+  throw new Error(`Unexpected MCP body: ${trimmed}`);
+}
+
+test('getTransport defaults to stdio and normalizes case', () => {
+  assert.equal(getTransport({}), 'stdio');
+  assert.equal(getTransport({ MCP_TRANSPORT: ' Streamable-HTTP ' }), 'streamable-http');
+});
+
+test('validateAndReadImage reads data:image/...;base64,... URLs and checks MIME/size', async () => {
+  const dataUrl = `data:image/png;base64,${FAKE_PNG.toString('base64')}`;
+  const res = await validateAndReadImage(dataUrl);
+  assert.equal(res.mimeType, 'image/png');
+  assert.equal(res.sizeBytes, FAKE_PNG.length);
+  assert.equal(Buffer.from(res.base64, 'base64').compare(FAKE_PNG), 0);
+
+  await assert.rejects(
+    () => validateAndReadImage('data:text/plain;base64,SGVsbG8='),
+    (err) => err instanceof VisionBridgeError && err.code === ErrorCode.UNSUPPORTED_TYPE,
+  );
+
+  await assert.rejects(
+    () => validateAndReadImage(dataUrl, { maxBytes: 4 }),
+    (err) => err instanceof VisionBridgeError && err.code === ErrorCode.FILE_TOO_LARGE,
+  );
+});
+
+test('validateAndReadImage fetches http:// image URLs and enforces size/MIME/status', async () => {
+  const srv = http.createServer((req, res) => {
+    if (req.url === '/ok.png') {
+      res.writeHead(200, { 'Content-Type': 'image/png' });
+      res.end(FAKE_PNG);
+      return;
+    }
+    if (req.url === '/bad.txt') {
+      res.writeHead(200, { 'Content-Type': 'text/plain' });
+      res.end('not an image');
+      return;
+    }
+    res.writeHead(404);
+    res.end('missing');
+  });
+
+  await new Promise((resolve) => srv.listen(0, '127.0.0.1', resolve));
+  const { port } = srv.address();
+  try {
+    const ok = await validateAndReadImage(`http://127.0.0.1:${port}/ok.png`);
+    assert.equal(ok.mimeType, 'image/png');
+    assert.equal(ok.sizeBytes, FAKE_PNG.length);
+
+    await assert.rejects(
+      () => validateAndReadImage(`http://127.0.0.1:${port}/missing.png`),
+      (err) => err instanceof VisionBridgeError && err.code === ErrorCode.FILE_NOT_FOUND,
+    );
+
+    await assert.rejects(
+      () => validateAndReadImage(`http://127.0.0.1:${port}/bad.txt`),
+      (err) => err instanceof VisionBridgeError && err.code === ErrorCode.UNSUPPORTED_TYPE,
+    );
+  } finally {
+    await new Promise((resolve) => srv.close(resolve));
+  }
+});
+
+test('Streamable HTTP serves /health, /healthz, and /mcp (initialize, tools/list, tools/call)', async () => {
+  const prevKey = process.env.GEMINI_API_KEY;
+  delete process.env.GEMINI_API_KEY;
+
+  const srv = createHttpServer({ stateless: true });
+  await new Promise((resolve) => srv.listen(0, '127.0.0.1', resolve));
+  const { port } = srv.address();
+  const base = `http://127.0.0.1:${port}`;
+  const headers = {
+    'Content-Type': 'application/json',
+    Accept: 'application/json, text/event-stream',
+  };
+
+  try {
+    for (const p of ['/health', '/healthz']) {
+      const h = await fetch(`${base}${p}`);
+      assert.equal(h.status, 200);
+      const body = await h.json();
+      assert.equal(body.status, 'ok');
+      assert.equal(body.transport, 'streamable-http');
+      assert.equal(body.gemini_key_configured, false);
+    }
+
+    const init = await fetch(`${base}/mcp`, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({
+        jsonrpc: '2.0',
+        id: 1,
+        method: 'initialize',
+        params: {
+          protocolVersion: '2025-03-26',
+          capabilities: {},
+          clientInfo: { name: 'test', version: '1.0' },
+        },
+      }),
+    });
+    assert.equal(init.status, 200);
+    const initJson = parseMcpBody(await init.text());
+    assert.equal(initJson.result.serverInfo.name, 'vision-bridge-mcp');
+
+    const notif = await fetch(`${base}/mcp`, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({ jsonrpc: '2.0', method: 'notifications/initialized' }),
+    });
+    assert.equal(notif.status, 202);
+
+    const list = await fetch(`${base}/mcp`, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({ jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} }),
+    });
+    assert.equal(list.status, 200);
+    const names = parseMcpBody(await list.text()).result.tools.map((t) => t.name);
+    assert.deepEqual(names, ['analyze_image', 'ocr_image']);
+
+    const call = await fetch(`${base}/mcp`, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({
+        jsonrpc: '2.0',
+        id: 3,
+        method: 'tools/call',
+        params: { name: 'ocr_image', arguments: { image_path: 'unused.png' } },
+      }),
+    });
+    assert.equal(call.status, 200);
+    const callJson = parseMcpBody(await call.text());
+    assert.equal(callJson.result.isError, true);
+    assert.match(callJson.result.content[0].text, /MISSING_API_KEY/);
+  } finally {
+    if (prevKey !== undefined) process.env.GEMINI_API_KEY = prevKey;
+    await new Promise((resolve) => srv.close(resolve));
+  }
+});
