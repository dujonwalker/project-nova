   '.heif': 'image/heif',
 });

+const SUPPORTED_MIME_TYPES = new Set(Object.values(SUPPORTED_EXTENSIONS));
+
+function normalizeMimeType(raw) {
+  if (!raw || typeof raw !== 'string') return '';
+  const clean = raw.split(';', 1)[0].trim().toLowerCase();
+  if (clean === 'image/jpg') return 'image/jpeg';
+  return clean;
+}
+
+function assertWithinMaxBytes(sizeBytes, maxBytes, label) {
+  if (sizeBytes === 0) {
+    throw new VisionBridgeError(ErrorCode.READ_ERROR, `"${label}" is empty.`);
+  }
+  if (sizeBytes > maxBytes) {
+    const sizeMb = (sizeBytes / (1024 * 1024)).toFixed(1);
+    const limitMb = (maxBytes / (1024 * 1024)).toFixed(1);
+    throw new VisionBridgeError(
+      ErrorCode.FILE_TOO_LARGE,
+      `"${label}" is ${sizeMb}MB, which exceeds the ${limitMb}MB limit. ` +
+        'Resize/compress the image, or raise VISION_BRIDGE_MAX_IMAGE_MB.',
+    );
+  }
+}
+
+function parseDataUrl(input, maxBytes) {
+  const match = /^data:([^;,]+);base64,([A-Za-z0-9+/=\s]+)$/i.exec(input);
+  if (!match) {
+    throw new VisionBridgeError(
+      ErrorCode.UNSUPPORTED_TYPE,
+      'Invalid data URL. Expected "data:image/<type>;base64,<payload>".',
+    );
+  }
+  const mimeType = normalizeMimeType(match[1]);
+  if (!SUPPORTED_MIME_TYPES.has(mimeType)) {
+    throw new VisionBridgeError(
+      ErrorCode.UNSUPPORTED_TYPE,
+      `Unsupported image MIME type "${mimeType}". Supported types: ${[...SUPPORTED_MIME_TYPES].join(', ')}.`,
+    );
+  }
+  const buffer = Buffer.from(match[2].replace(/\s+/g, ''), 'base64');
+  assertWithinMaxBytes(buffer.length, maxBytes, 'data-url');
+  return {
+    absolutePath: 'data-url',
+    mimeType,
+    base64: buffer.toString('base64'),
+    sizeBytes: buffer.length,
+  };
+}
+
+async function fetchRemoteImage(imageUrl, maxBytes) {
+  let res;
+  try {
+    res = await fetch(imageUrl, {
+      redirect: 'follow',
+      signal: AbortSignal.timeout(30000),
+    });
+  } catch (err) {
+    throw new VisionBridgeError(
+      ErrorCode.READ_ERROR,
+      `Failed to fetch "${imageUrl}": ${err && err.message ? err.message : err}`,
+    );
+  }
+
+  if (!res.ok) {
+    throw new VisionBridgeError(
+      res.status === 404 ? ErrorCode.FILE_NOT_FOUND : ErrorCode.READ_ERROR,
+      `Failed to fetch "${imageUrl}": HTTP ${res.status}`,
+    );
+  }
+
+  const contentLength = Number(res.headers.get('content-length') || '0');
+  if (Number.isFinite(contentLength) && contentLength > maxBytes) {
+    assertWithinMaxBytes(contentLength, maxBytes, imageUrl);
+  }
+
+  const headerMime = normalizeMimeType(res.headers.get('content-type') || '');
+  let mimeType = SUPPORTED_MIME_TYPES.has(headerMime) ? headerMime : '';
+  if (!mimeType) {
+    const pathname = new URL(imageUrl).pathname;
+    const ext = path.extname(pathname).toLowerCase();
+    mimeType = SUPPORTED_EXTENSIONS[ext] || '';
+  }
+  if (!mimeType) {
+    throw new VisionBridgeError(
+      ErrorCode.UNSUPPORTED_TYPE,
+      `Unsupported image type "${headerMime || '(unknown)'}" from "${imageUrl}".`,
+    );
+  }
+
+  const buffer = Buffer.from(await res.arrayBuffer());
+  assertWithinMaxBytes(buffer.length, maxBytes, imageUrl);
+  return {
+    absolutePath: imageUrl,
+    mimeType,
+    base64: buffer.toString('base64'),
+    sizeBytes: buffer.length,
+  };
+}
