+import http from 'node:http';
+import { randomUUID } from 'node:crypto';
+import { StreamableHTTPServerTransport } from '@modelcontextprotocol/sdk/server/streamableHttp.js';
+
+import { createServer } from './server.js';
+import { defaults, hasApiKey } from './config.js';
+
+const PACKAGE_VERSION = '0.1.2';
+
+/**
+ * Returns the configured MCP transport ('stdio' by default, or 'streamable-http').
+ *
+ * @param {NodeJS.ProcessEnv} [env]
+ * @returns {string}
+ */
+export function getTransport(env = process.env) {
+  return (env.MCP_TRANSPORT || 'stdio').trim().toLowerCase() || 'stdio';
+}
+
+function isStateless(env = process.env) {
+  const raw = (env.MCP_STATELESS_HTTP ?? 'true').trim().toLowerCase();
+  return !['0', 'false', 'no', 'off'].includes(raw);
+}
+
+/**
+ * Builds the Node HTTP server serving /mcp (Streamable HTTP) and /health(/healthz).
+ *
+ * @param {{ stateless?: boolean }} [options]
+ * @returns {http.Server}
+ */
+export function createHttpServer(options = {}) {
+  const stateless = options.stateless ?? isStateless();
+  const sessions = new Map();
+
+  return http.createServer(async (req, res) => {
+    const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+
+    if (
+      (req.method === 'GET' || req.method === 'HEAD') &&
+      (url.pathname === '/health' || url.pathname === '/healthz')
+    ) {
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      if (req.method === 'HEAD') {
+        res.end();
+        return;
+      }
+      res.end(
+        JSON.stringify({
+          status: 'ok',
+          transport: 'streamable-http',
+          server: 'vision-bridge-mcp',
+          version: PACKAGE_VERSION,
+          gemini_key_configured: hasApiKey(),
+          model: (process.env.GEMINI_MODEL || '').trim() || defaults.model,
+        }),
+      );
+      return;
+    }
+
+    if (url.pathname === '/mcp' || url.pathname.startsWith('/mcp/')) {
+      try {
+        if (stateless) {
+          const server = createServer();
+          const transport = new StreamableHTTPServerTransport({
+            sessionIdGenerator: undefined,
+          });
+          res.on('close', () => {
+            transport.close().catch(() => {});
+            server.close().catch(() => {});
+          });
+          await server.connect(transport);
+          await transport.handleRequest(req, res);
+          return;
+        }
+
+        const sessionId = req.headers['mcp-session-id'];
+        if (sessionId) {
+          if (!sessions.has(sessionId)) {
+            res.writeHead(404, { 'Content-Type': 'application/json' });
+            res.end(
+              JSON.stringify({
+                jsonrpc: '2.0',
+                error: { code: -32001, message: 'Session not found' },
+                id: null,
+              }),
+            );
+            return;
+          }
+          const session = sessions.get(sessionId);
+          await session.transport.handleRequest(req, res);
+          return;
+        }
+
+        const server = createServer();
+        const transport = new StreamableHTTPServerTransport({
+          sessionIdGenerator: () => randomUUID(),
+          onsessioninitialized: (sid) => {
+            sessions.set(sid, { transport, server });
+          },
+        });
+        transport.onclose = () => {
+          if (transport.sessionId) {
+            sessions.delete(transport.sessionId);
+          }
+        };
+        await server.connect(transport);
+        await transport.handleRequest(req, res);
+      } catch (err) {
+        console.error('[vision-bridge-mcp] error handling /mcp request:', err);
+        if (!res.headersSent) {
+          res.writeHead(500, { 'Content-Type': 'application/json' });
+          res.end(JSON.stringify({ error: 'Internal server error' }));
+        }
+      }
+      return;
+    }
+
+    res.writeHead(404, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({ error: 'Not found. Use /mcp for Streamable HTTP.' }));
+  });
+}
+
+/**
+ * Starts the Streamable HTTP server and installs graceful shutdown handlers.
+ *
+ * @returns {Promise<http.Server>}
+ */
+export async function startHttpServer() {
+  const host = (process.env.SSE_HOST || process.env.MCP_HOST || '0.0.0.0').trim() || '0.0.0.0';
+  const port = Number.parseInt(
+    (process.env.SSE_PORT || process.env.MCP_PORT || '3024').trim(),
+    10,
+  );
+  const httpServer = createHttpServer();
+
+  await new Promise((resolve, reject) => {
+    httpServer.once('error', reject);
+    httpServer.listen(port, host, () => {
+      httpServer.off('error', reject);
+      resolve();
+    });
+  });
+
+  console.error(
+    `[vision-bridge-mcp] ready on http://${host}:${port}/mcp (tools: analyze_image, ocr_image)`,
+  );
+  if (!hasApiKey()) {
+    console.error(
+      '[vision-bridge-mcp] warning: GEMINI_API_KEY is not set — tool calls will fail until ' +
+        'it is configured. Get a free key at https://aistudio.google.com/apikey',
+    );
+  }
+
+  for (const signal of ['SIGTERM', 'SIGINT']) {
+    process.on(signal, () => {
+      httpServer.close(() => {
+        process.exit(0);
+      });
+    });
+  }
+
+  return httpServer;
+}
