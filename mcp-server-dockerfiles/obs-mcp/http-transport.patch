+def _env_bool(name: str, default: bool) -> bool:
+    raw = os.environ.get(name)
+    if raw is None or not raw.strip():
+        return default
+    return raw.strip().lower() in ("1", "true", "yes", "on")
+
+
+def _normalize_obs_env() -> None:
+    """Normalize blank env vars and support OBS_WEBSOCKET_* fallbacks."""
+    if not os.environ.get("OBS_HOST", "").strip():
+        os.environ.pop("OBS_HOST", None)
+    if not os.environ.get("OBS_PORT", "").strip():
+        os.environ.pop("OBS_PORT", None)
+
+    ws_url = os.environ.get("OBS_WEBSOCKET_URL", "").strip()
+    if ws_url and "OBS_HOST" not in os.environ:
+        parsed = urlparse(ws_url if "://" in ws_url else f"ws://{ws_url}")
+        if parsed.hostname:
+            os.environ["OBS_HOST"] = parsed.hostname
+        if parsed.port and "OBS_PORT" not in os.environ:
+            os.environ["OBS_PORT"] = str(parsed.port)
+
+    os.environ.setdefault("OBS_HOST", "host.docker.internal")
+
+    ws_pw = os.environ.get("OBS_WEBSOCKET_PASSWORD", "")
+    if ws_pw and not os.environ.get("OBS_PASSWORD", ""):
+        os.environ["OBS_PASSWORD"] = ws_pw
+
+
+_normalize_obs_env()

