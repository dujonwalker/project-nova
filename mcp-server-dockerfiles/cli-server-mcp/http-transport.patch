+func TestHTTPHandler(t *testing.T) {
+	logger := zerolog.Nop()
+	wsDir := t.TempDir()
+	cfg := &Config{
+		Server: ServerConfig{Name: "mcp-shell-test", Version: "1.1.1"},
+		Security: SecurityConfig{
+			Enabled:          false,
+			MaxExecutionTime: 10 * time.Second,
+			MaxOutputSize:    65536,
+			WorkingDirectory: wsDir,
+		},
+	}
+
+	executor := newCommandExecutor(cfg.Security, logger)
+	s := server.NewMCPServer(cfg.Server.Name, cfg.Server.Version, server.WithToolCapabilities(false))
+	require.NoError(t, registerTools(s, cfg, executor, logger))
+
+	ts := httptest.NewServer(buildHTTPHandler(s, cfg, true))
+	defer ts.Close()
+
+	for _, path := range []string{"/health", "/healthz"} {
+		resp, err := http.Get(ts.URL + path)
+		require.NoError(t, err)
+		var body map[string]any
+		require.NoError(t, json.NewDecoder(resp.Body).Decode(&body))
+		require.NoError(t, resp.Body.Close())
+		assert.Equal(t, http.StatusOK, resp.StatusCode)
+		assert.Equal(t, "ok", body["status"])
+		assert.Equal(t, true, body["unsafe"])
+		assert.Equal(t, false, body["security_enabled"])
+	}
+
+	postMCP := func(payload map[string]any) (int, map[string]any) {
+		raw, err := json.Marshal(payload)
+		require.NoError(t, err)
+		req, err := http.NewRequest(http.MethodPost, ts.URL+"/mcp", bytes.NewReader(raw))
+		require.NoError(t, err)
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Accept", "application/json, text/event-stream")
+		resp, err := ts.Client().Do(req)
+		require.NoError(t, err)
+		defer resp.Body.Close()
+
+		if resp.StatusCode == http.StatusAccepted {
+			return resp.StatusCode, nil
+		}
+		var out map[string]any
+		require.NoError(t, json.NewDecoder(resp.Body).Decode(&out))
+		return resp.StatusCode, out
+	}
+
+	status, initResp := postMCP(map[string]any{
+		"jsonrpc": "2.0",
+		"id":      1,
+		"method":  "initialize",
+		"params": map[string]any{
+			"protocolVersion": "2025-03-26",
+			"capabilities":    map[string]any{},
+			"clientInfo":      map[string]any{"name": "test-client", "version": "1.0.0"},
+		},
+	})
+	assert.Equal(t, http.StatusOK, status)
+	assert.Contains(t, initResp, "result")
+
+	status, _ = postMCP(map[string]any{
+		"jsonrpc": "2.0",
+		"method":  "notifications/initialized",
+	})
+	assert.Contains(t, []int{http.StatusOK, http.StatusAccepted}, status)
+
+	status, listResp := postMCP(map[string]any{
+		"jsonrpc": "2.0",
+		"id":      2,
+		"method":  "tools/list",
+		"params":  map[string]any{},
+	})
+	assert.Equal(t, http.StatusOK, status)
+	toolsResult := listResp["result"].(map[string]any)
+	tools := toolsResult["tools"].([]any)
+	require.Len(t, tools, 1)
+	assert.Equal(t, "shell_exec", tools[0].(map[string]any)["name"])
+
+	status, callResp := postMCP(map[string]any{
+		"jsonrpc": "2.0",
+		"id":      3,
+		"method":  "tools/call",
+		"params": map[string]any{
+			"name":      "shell_exec",
+			"arguments": map[string]any{"command": "echo hello-http && pwd"},
+		},
+	})
+	assert.Equal(t, http.StatusOK, status)
+	content := callResp["result"].(map[string]any)["content"].([]any)
+	require.NotEmpty(t, content)
+	var execOut map[string]any
+	require.NoError(t, json.Unmarshal([]byte(content[0].(map[string]any)["text"].(string)), &execOut))
+	assert.Equal(t, float64(0), execOut["exit_code"])
+	assert.Contains(t, execOut["stdout"], "hello-http")
+	assert.Contains(t, execOut["stdout"], wsDir)
