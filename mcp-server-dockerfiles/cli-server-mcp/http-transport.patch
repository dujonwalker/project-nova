+func buildHTTPHandler(s *server.MCPServer, cfg *Config, stateless bool) http.Handler {
+	opts := []server.StreamableHTTPOption{
+		server.WithEndpointPath("/mcp"),
+	}
+	if stateless {
+		opts = append(opts, server.WithStateLess(true))
+	} else {
+		opts = append(opts, server.WithStateful(true))
+	}
+
+	streamable := server.NewStreamableHTTPServer(s, opts...)
+	mux := http.NewServeMux()
+
+	healthHandler := func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		if r.Method == http.MethodHead {
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"status":           "ok",
+			"transport":        "streamable-http",
+			"server":           cfg.Server.Name,
+			"version":          cfg.Server.Version,
+			"security_enabled": cfg.Security.Enabled,
+			"unsafe":           !cfg.Security.Enabled,
+		})
+	}
+
+	mux.HandleFunc("/health", healthHandler)
+	mux.HandleFunc("/healthz", healthHandler)
+	mux.Handle("/mcp", streamable)

-	return nil
+	return mux
 }

