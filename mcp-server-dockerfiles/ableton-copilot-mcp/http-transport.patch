+def _env_bool(name: str, default: bool) -> bool:
+    raw = os.environ.get(name)
+    if raw is None or not raw.strip():
+        return default
+    return raw.strip().lower() in ("1", "true", "yes", "on")
+
+
+def _normalize_ableton_env() -> None:
+    """Normalize blank env vars and support ABLETON_IP fallback."""
+    if not os.environ.get("ABLETON_HOST", "").strip():
+        os.environ.pop("ABLETON_HOST", None)
+    if not os.environ.get("ABLETON_PORT", "").strip():
+        os.environ.pop("ABLETON_PORT", None)
+
+    ableton_ip = os.environ.get("ABLETON_IP", "").strip()
+    if ableton_ip and "ABLETON_HOST" not in os.environ:
+        os.environ["ABLETON_HOST"] = ableton_ip
+
+    os.environ.setdefault("ABLETON_HOST", "host.docker.internal")
+
+
+def _is_http_transport() -> bool:
+    transport = os.environ.get("MCP_TRANSPORT", "streamable-http").strip().lower() or "streamable-http"
+    return transport in ("streamable-http", "sse")
+
+
+_normalize_ableton_env()
+
+ABLETON_HOST = os.environ.get("ABLETON_HOST", "host.docker.internal")
